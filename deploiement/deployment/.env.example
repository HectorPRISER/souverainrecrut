# Modèle de configuration. Copier en .env (NON versionné) et renseigner les valeurs.
# En pipeline GitLab, ces valeurs viennent des variables CI/CD masquées, jamais du dépôt.

# Identification de l'environnement (permet staging + production sur le même serveur)
COMPOSE_PROJECT_NAME=souverainrecrut-prod
API_PORT=4000

# Image publiée par Jenkins : tag immuable (version + commit), jamais "latest"
BACKEND_IMAGE=hector29600/souverainrecrut-backend:1.0.0-sha-xxxxxxx

# Base de données
POSTGRES_USER=souverain
POSTGRES_PASSWORD=change-me
POSTGRES_DB=souverainrecrut

# API
JWT_SECRET=change-me-long-random-string
FRONTEND_URL=http://localhost:5173

# Admin initial (optionnel : créé s'il n'existe pas, sinon laissé intact)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Version de la CLI Prisma utilisée par le service de migration
PRISMA_VERSION=6.19.3
