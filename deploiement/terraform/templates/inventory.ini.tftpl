# Fichier GÉNÉRÉ par Terraform (deploiement/terraform). Ne pas modifier à la main :
# modifier les variables Terraform puis relancer "terraform apply".

[deploy_servers]
${vm_name} ansible_host=${vm_ip} ansible_port=${ssh_port}

[deploy_servers:vars]
ansible_user=${ssh_user}
ansible_ssh_private_key_file=${ssh_private_key_path}
ansible_python_interpreter=/usr/bin/python3
deploy_dir=${deploy_dir}
